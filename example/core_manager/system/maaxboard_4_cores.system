<?xml version="1.0" encoding="UTF-8"?>
<system>
    <memory_region name="bootstrap_mem" size="0x10_000" phys_addr="0x60_000_000"/>
    <memory_region name="uart" size="0x1_000" phys_addr="0x30_860_000"/>
    <memory_region name="gpt" size="0x1_000" phys_addr="0x30_2d0_000"/>
    <memory_region name="uart_buffer" size="0x1_000"/>
    <memory_region name="worker_buffer" size="0x1_000"/>
    
    <protection_domain name="core_manager_api" priority="253" smc="true">
        <program_image path="core_manager_api.elf"/>
        <map mr="uart" vaddr="0x2000000" perms="rw" cached="false" setvar_vaddr="uart_base_vaddr"/>
        <map mr="bootstrap_mem" vaddr="0x5000000" perms="rwx" setvar_vaddr="bootstrap_vaddr"/>
        <map mr="worker_buffer" vaddr="0x4000000" perms="rw" setvar_vaddr="instruction_vaddr"/>
        <setvar symbol="bootstrap_entry" region_paddr="bootstrap_mem"/>

        <protection_domain name="core_worker0" priority="254" cpu="0" smc="true" id="1">
            <program_image path="core_worker.elf"/>
            <map mr="worker_buffer" vaddr="0x4000000" perms="r" setvar_vaddr="instruction_vaddr"/>
            <map mr="uart" vaddr="0x2000000" perms="rw" cached="false" setvar_vaddr="uart_base_vaddr"/>
        </protection_domain>

        <protection_domain name="core_worker1" priority="254" cpu="1" smc="true" id="2">
            <program_image path="core_worker.elf"/>
            <map mr="worker_buffer" vaddr="0x4000000" perms="r" setvar_vaddr="instruction_vaddr"/>
            <map mr="uart" vaddr="0x2000000" perms="rw" cached="false" setvar_vaddr="uart_base_vaddr"/>
        </protection_domain>

        <protection_domain name="core_worker2" priority="254" cpu="2" smc="true" id="3">
            <program_image path="core_worker.elf"/>
            <map mr="worker_buffer" vaddr="0x4000000" perms="r" setvar_vaddr="instruction_vaddr"/>
            <map mr="uart" vaddr="0x2000000" perms="rw" cached="false" setvar_vaddr="uart_base_vaddr"/>
        </protection_domain>

        <protection_domain name="core_worker3" priority="254" cpu="3" smc="true" id="4">
            <program_image path="core_worker.elf"/>
            <map mr="worker_buffer" vaddr="0x4000000" perms="r" setvar_vaddr="instruction_vaddr"/>
            <map mr="uart" vaddr="0x2000000" perms="rw" cached="false" setvar_vaddr="uart_base_vaddr"/>
        </protection_domain>

        <protection_domain name="core_manager" priority="251" id="5">
            <program_image path="core_manager.elf"/>
            <map mr="uart" vaddr="0x2000000" perms="rw" cached="false" setvar_vaddr="uart_base_vaddr"/>
            <map mr="uart_buffer" vaddr="0x4000000" perms="rw" setvar_vaddr="cmd_buffer"/>
            <irq irq="58" id="2"/> <!-- UART interrupt -->
        </protection_domain>

        <protection_domain name="timer" priority="252" id="6">
            <program_image path="timer.elf"/>
            <map mr="uart" vaddr="0x2000000" perms="rw" cached="false" setvar_vaddr="uart_base_vaddr"/>
            <map mr="gpt" vaddr="0x3000000" perms="rw" cached="false" setvar_vaddr="gpt_base_vaddr"/>
            <irq irq="87" id="6" /> <!-- Timer interrupt -->
        </protection_domain>
    </protection_domain>

    <channel>
        <end pd="core_manager" id="1" pp="true"/>
        <end pd="core_manager_api" id="1"/>
    </channel>

    <channel>
        <end pd="core_manager" id="3" pp="true"/>
        <end pd="timer" id="1"/>
    </channel>

    <channel>
        <end pd="core_worker0" id="1"/>
        <end pd="core_manager_api" id="2" pp="true"/>
    </channel>
    
    <channel>
        <end pd="core_worker1" id="1"/>
        <end pd="core_manager_api" id="3" pp="true"/>
    </channel>

    <channel>
        <end pd="core_worker2" id="1"/>
        <end pd="core_manager_api" id="4" pp="true"/>
    </channel>

    <channel>
        <end pd="core_worker3" id="1"/>
        <end pd="core_manager_api" id="5" pp="true"/>
    </channel>
        
    <channel>
        <end pd="timer" id="2" pp="true"/>
        <end pd="core_manager_api" id="6"/>
    </channel>
</system>
